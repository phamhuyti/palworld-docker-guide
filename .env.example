# Copy file này thành .env (cùng thư mục compose.yaml) rồi điền mật khẩu thật.
# File .env KHÔNG được commit (đã có trong .gitignore).

# AdminPassword của server — phải trùng AdminPassword trong PalWorldSettings.ini.
# Dùng cho REST/RCON và (mặc định) cả đăng nhập admin-tool.
PAL_ADMIN_PASSWORD=doi-mat-khau-nay

# (Tùy chọn) Mật khẩu đăng nhập riêng cho admin-tool, tách khỏi AdminPassword.
# Bỏ trống dòng này = dùng chung PAL_ADMIN_PASSWORD.
#PAL_APP_PASSWORD=mat-khau-dang-nhap-app-rieng
